{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "paths": {
      "@pages/*": [
        "./pages/*"
      ],
      "@fixtures": [
        "./fixtures/index.ts"
      ],
      "@fixtures/*": [
        "./fixtures/*"
      ]
    }
  },
  "include": [
    "./**/*"
  ]
}